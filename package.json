{
  "name": "@lautstark/design",
  "version": "1.37.0",
  "type": "module",
  "description": "The look the Lautstark AAC tools share: one accent hue per product, every other token derived from it and contrast-checked before it ships.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lautstark/design.git"
  },
  "homepage": "https://lautstark.github.io/design/",
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "contrast",
    "oklch",
    "aac"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "tokens",
    "docs/components.css",
    "docs/lib",
    "docs/design.md",
    "docs/conventions.md",
    "build.js",
    "products",
    "pins.js",
    "installcheck.mjs",
    "shadows.js",
    "svelte",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./docs/lib/derive.js",
    "./oklch": "./docs/lib/oklch.js",
    "./emit": "./docs/lib/emit.js",
    "./components.css": "./docs/components.css",
    "./tokens/*": "./tokens/*",
    "./theme": {
      "types": "./docs/lib/theme.d.ts",
      "default": "./docs/lib/theme.js"
    },
    "./menu": {
      "types": "./docs/lib/menu.d.ts",
      "default": "./docs/lib/menu.js"
    },
    "./dialog": {
      "types": "./docs/lib/dialog.d.ts",
      "default": "./docs/lib/dialog.js"
    },
    "./rename": {
      "types": "./docs/lib/rename.d.ts",
      "default": "./docs/lib/rename.js"
    },
    "./toast": {
      "types": "./docs/lib/toast.d.ts",
      "default": "./docs/lib/toast.js"
    },
    "./collections": {
      "types": "./docs/lib/collections.d.ts",
      "default": "./docs/lib/collections.js"
    },
    "./crop": {
      "types": "./docs/lib/crop.d.ts",
      "default": "./docs/lib/crop.js"
    },
    "./language": {
      "types": "./docs/lib/language.d.ts",
      "default": "./docs/lib/language.js"
    },
    "./css": {
      "types": "./docs/lib/css.d.ts",
      "default": "./docs/lib/css.js"
    },
    "./svelte/Vanilla": {
      "svelte": "./svelte/Vanilla.svelte",
      "default": "./svelte/Vanilla.svelte"
    },
    "./svelte/Panel": {
      "svelte": "./svelte/Panel.svelte",
      "default": "./svelte/Panel.svelte"
    },
    "./svelte/Sheet": {
      "svelte": "./svelte/Sheet.svelte",
      "default": "./svelte/Sheet.svelte"
    },
    "./svelte/TileGrid": {
      "svelte": "./svelte/TileGrid.svelte",
      "default": "./svelte/TileGrid.svelte"
    },
    "./svelte/Tile": {
      "svelte": "./svelte/Tile.svelte",
      "default": "./svelte/Tile.svelte"
    },
    "./svelte/Overflow": {
      "svelte": "./svelte/Overflow.svelte",
      "default": "./svelte/Overflow.svelte"
    },
    "./svelte/Dropdown": {
      "svelte": "./svelte/Dropdown.svelte",
      "default": "./svelte/Dropdown.svelte"
    },
    "./svelte/ThemePicker": {
      "svelte": "./svelte/ThemePicker.svelte",
      "default": "./svelte/ThemePicker.svelte"
    },
    "./svelte/TitleField": {
      "svelte": "./svelte/TitleField.svelte",
      "default": "./svelte/TitleField.svelte"
    },
    "./svelte/Sidebar": {
      "svelte": "./svelte/Sidebar.svelte",
      "default": "./svelte/Sidebar.svelte"
    },
    "./svelte/Scrim": {
      "svelte": "./svelte/Scrim.svelte",
      "default": "./svelte/Scrim.svelte"
    },
    "./svelte/Reveal": {
      "svelte": "./svelte/Reveal.svelte",
      "default": "./svelte/Reveal.svelte"
    },
    "./svelte/TopBar": {
      "svelte": "./svelte/TopBar.svelte",
      "default": "./svelte/TopBar.svelte"
    },
    "./svelte/Crop": {
      "svelte": "./svelte/Crop.svelte",
      "default": "./svelte/Crop.svelte"
    },
    "./svelte/Footer": {
      "svelte": "./svelte/Footer.svelte",
      "default": "./svelte/Footer.svelte"
    },
    "./svelte/Legal": {
      "svelte": "./svelte/Legal.svelte",
      "default": "./svelte/Legal.svelte"
    },
    "./svelte/sidebar": {
      "types": "./svelte/sidebar.d.ts",
      "svelte": "./svelte/sidebar.js",
      "default": "./svelte/sidebar.js"
    },
    "./svelte/sheet": {
      "types": "./svelte/sheet.d.ts",
      "svelte": "./svelte/sheet.js",
      "default": "./svelte/sheet.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.js",
    "check": "node build.js --check",
    "pins": "node pins.js",
    "typecheck": "svelte-check --threshold warning",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "happy-dom": "^20.11.6",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
